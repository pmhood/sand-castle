# Exact versions, never ranges: `npm install <pkg>` writes "1.2.3", not "^1.2.3". Same posture as
# the Dockerfile's CLI pins and the workflows' action SHAs -- a dependency that moves on its own
# either turns an unrelated pull request red or quietly starts running code this repo never
# reviewed. Dependabot proposes the bumps; see .github/dependabot.yml.
save-exact=true
